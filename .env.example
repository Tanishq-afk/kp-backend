# ----------------------------------------------------------------------------
# KP Backend — Environment variables
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# ----------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Database — your MongoDB connection string
# Local example:  mongodb://127.0.0.1:27017/kp_inventory
# Atlas example:  mongodb+srv://<user>:<pass>@cluster0.xxxx.mongodb.net/kp_inventory
MONGODB_URI=

# Auth (JWT)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Seed accounts (created by `npm run seed`) — the two fixed logins.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=ChangeMe@123

ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123

# CORS — comma-separated list of allowed frontend origins (optional)
# Leave blank to allow all origins in development.
CORS_ORIGINS=http://localhost:5173
